{
  "name": "@yasainet/eslint",
  "version": "0.0.0",
  "description": "ESLint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasainet/eslint.git"
  },
  "type": "module",
  "exports": {
    "./next": {
      "types": "./src/next/index.d.mts",
      "default": "./src/next/index.mjs"
    }
  },
  "files": [
    "src"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "nextjs",
    "typescript"
  ],
  "author": "yasainet",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node scripts/check-layer-selectors.mjs && node scripts/check-rule-scoping.mjs",
    "lint:md": "markdownlint-cli2 \"**/*.md\" && textlint \"**/*.md\""
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.9.0",
    "eslint-plugin-better-tailwindcss": "^4.1.1",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-simple-import-sort": "^12.1.1"
  },
  "peerDependencies": {
    "eslint": "^9",
    "typescript-eslint": "^8"
  },
  "devDependencies": {
    "eslint": "^9",
    "markdownlint-cli2": "^0.23.2",
    "textlint": "^15.8.0",
    "textlint-rule-max-ten": "^5.0.0",
    "textlint-rule-sentence-length": "^5.2.1",
    "typescript-eslint": "^8"
  }
}
